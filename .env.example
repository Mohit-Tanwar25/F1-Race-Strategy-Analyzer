# Database Configuration (PostgreSQL for Docker, SQLite default for local dev)
DATABASE_URL=postgresql://f1user:f1password@localhost:5432/f1_strategy
# Local SQLite Alternative:
# DATABASE_URL=sqlite:///./f1_strategy.db

# Frontend API Base URL
VITE_API_URL=http://localhost:8000/api

# Ingestion / Telemetry Cache
DATA_PROVIDER_ONLINE_FALLBACK=true
CACHE_TTL_SECONDS=300
